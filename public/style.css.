* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --primary: #0f766e;
  --primary-dark: #115e59;
  --secondary: #f59e0b;
  --dark: #172033;
  --text: #374151;
  --muted: #6b7280;
  --light: #f8fafc;
  --white: #ffffff;
  --border: #e5e7eb;
  --danger: #dc2626;
  --success: #16a34a;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: var(--light);
  color: var(--text);
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

/* Header */
header {
  background: var(--white);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 1000;
}

.navbar {
  max-width: 1200px;
  margin: auto;
  min-height: 70px;
  padding: 0 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.logo {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--primary);
}

.logo span {
  color: var(--secondary);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 22px;
}

.nav-links a {
  font-weight: 600;
  color: var(--dark);
}

.nav-links a:hover {
  color: var(--primary);
}

.menu-btn {
  display: none;
  border: none;
  background: transparent;
  font-size: 1.6rem;
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 11px 18px;
  border-radius: 8px;
  border: none;
  font-weight: 700;
  transition: 0.2s ease;
}

.btn-primary {
  background: var(--primary);
  color: var(--white);
}

.btn-primary:hover {
  background: var(--primary-dark);
}

.btn-secondary {
  background: var(--secondary);
  color: #111827;
}

.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 1px solid var(--primary);
}

.btn-danger {
  background: var(--danger);
  color: white;
}

/* Hero */
.hero {
  min-height: 520px;
  display: flex;
  align-items: center;
  background:
    linear-gradient(rgba(15, 118, 110, 0.82), rgba(17, 94, 89, 0.82)),
    url("/images/hero.jpg") center/cover no-repeat;
  color: var(--white);
}

.hero-content {
  max-width: 1200px;
  width: 100%;
  margin: auto;
  padding: 70px 20px;
}

.hero h1 {
  max-width: 750px;
  font-size: clamp(2.2rem, 6vw, 4.5rem);
  line-height: 1.05;
  margin-bottom: 20px;
}

.hero p {
  max-width: 650px;
  font-size: 1.15rem;
  margin-bottom: 30px;
}

/* Search */
.search-box {
  max-width: 1000px;
  margin: -35px auto 40px;
  position: relative;
  z-index: 5;
  background: var(--white);
  padding: 20px;
  border-radius: 14px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
}

.search-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr auto;
  gap: 12px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form-group label {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--dark);
}

input,
select,
textarea {
  width: 100%;
  padding: 12px 13px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: white;
  color: var(--dark);
  outline: none;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--primary);
}

/* Sections */
.container {
  max-width: 1200px;
  margin: auto;
  padding: 50px 20px;
}

.section-title {
  text-align: center;
  margin-bottom: 30px;
}

.section-title h2 {
  color: var(--dark);
  font-size: 2rem;
  margin-bottom: 8px;
}

.section-title p {
  color: var(--muted);
}

/* Country cards */
.country-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.country-card {
  background: var(--white);
  padding: 25px 18px;
  text-align: center;
  border-radius: 12px;
  border: 1px solid var(--border);
  transition: 0.2s ease;
}

.country-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
}

.country-card .flag {
  font-size: 2.5rem;
  margin-bottom: 10px;
}

.country-card h3 {
  color: var(--dark);
}

/* Property cards */
.property-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.property-card {
  background: var(--white);
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid var(--border);
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
}

.property-image {
  height: 220px;
  background: #e5e7eb;
  overflow: hidden;
}

.property-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.property-content {
  padding: 18px;
}

.property-content h3 {
  color: var(--dark);
  margin-bottom: 6px;
}

.property-location {
  color: var(--muted);
  font-size: 0.9rem;
  margin-bottom: 10px;
}

.property-price {
  color: var(--primary);
  font-size: 1.15rem;
  font-weight: 800;
  margin-bottom: 15px;
}

.property-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

/* Badges */
.badge {
  display: inline-block;
  padding: 5px 9px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 800;
}

.badge-featured {
  background: #fef3c7;
  color: #92400e;
}

.badge-premium {
  background: #ede9fe;
  color: #6d28d9;
}

.badge-sale {
  background: #dcfce7;
  color: #166534;
}

/* Forms */
.form-card {
  max-width: 700px;
  margin: 40px auto;
  background: var(--white);
  padding: 30px;
  border-radius: 14px;
  border: 1px solid var(--border);
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.06);
}

.form-card h2 {
  color: var(--dark);
  margin-bottom: 20px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
  margin-bottom: 15px;
}

/* Dashboard */
.dashboard {
  display: grid;
  grid-template-columns: 240px 1fr;
  min-height: calc(100vh - 70px);
}

.sidebar {
  background: var(--dark);
  color: white;
  padding: 25px 15px;
}

.sidebar a {
  display: block;
  padding: 12px 14px;
  border-radius: 7px;
  margin-bottom: 5px;
}

.sidebar a:hover,
.sidebar a.active {
  background: var(--primary);
}

.dashboard-content {
  padding: 30px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 30px;
}

.stat-card {
  background: white;
  padding: 20px;
  border-radius: 12px;
  border: 1px solid var(--border);
}

.stat-card h3 {
  color: var(--muted);
  font-size: 0.9rem;
}

.stat-card strong {
  display: block;
  margin-top: 5px;
  font-size: 1.8rem;
  color: var(--dark);
}

/* Tables */
.table-container {
  overflow-x: auto;
  background: white;
  border-radius: 12px;
  border: 1px solid var(--border);
}

table {
  width: 100%;
  border-collapse: collapse;
}

th,
td {
  padding: 14px;
  text-align: left;
  border-bottom: 1px solid var(--border);
}

th {
  background: #f8fafc;
  color: var(--dark);
}

/* Alerts */
.alert {
  padding: 13px 15px;
  border-radius: 8px;
  margin-bottom: 15px;
}

.alert-success {
  background: #dcfce7;
  color: #166534;
}

.alert-error {
  background: #fee2e2;
  color: #991b1b;
}

.alert-info {
  background: #dbeafe;
  color: #1e40af;
}

/* Footer */
footer {
  background: var(--dark);
  color: white;
  margin-top: 50px;
}

.footer-content {
  max-width: 1200px;
  margin: auto;
  padding: 45px 20px;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 30px;
}

.footer-content h3,
.footer-content h4 {
  margin-bottom: 12px;
}

.footer-content p,
.footer-content a {
  color: #cbd5e1;
}

.footer-content a {
  display: block;
  margin-bottom: 7px;
}

.footer-bottom {
  border-top: 1px solid #334155;
  padding: 18px 20px;
  text-align: center;
  color: #94a3b8;
}

/* Utilities */
.text-center {
  text-align: center;
}

.mt-20 {
  margin-top: 20px;
}

.mb-20 {
  margin-bottom: 20px;
}

.hidden {
  display: none !important;
}

/* Mobile */
@media (max-width: 900px) {
  .country-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .property-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-content {
    grid-template-columns: 1fr 1fr;
  }

  .search-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 650px) {
  .navbar {
    min-height: 60px;
  }

  .menu-btn {
    display: block;
  }

  .nav-links {
    display: none;
    position: absolute;
    top: 60px;
    left: 0;
    right: 0;
    background: white;
    padding: 15px 20px;
    flex-direction: column;
    align-items: stretch;
    border-bottom: 1px solid var(--border);
  }

  .nav-links.active {
    display: flex;
  }

  .hero {
    min-height: 450px;
  }

  .hero-content {
    padding: 50px 20px;
  }

  .country-grid,
  .property-grid,
  .stats-grid,
  .search-grid,
  .form-row {
    grid-template-columns: 1fr;
  }

  .dashboard {
    display: block;
  }

  .sidebar {
    display: none;
  }

  .dashboard-content {
    padding: 20px;
  }

  .footer-content {
    grid-template-columns: 1fr;
  }

  .form-card {
    margin: 20px;
    padding: 20px;
  }
}
